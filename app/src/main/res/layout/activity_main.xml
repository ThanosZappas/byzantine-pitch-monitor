<?xml version="1.0" encoding="utf-8"?>
<!-- Colours are applied at runtime from the theme palette (Theme.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

<LinearLayout
    android:id="@+id/column"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.03"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textSize="20dp" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/menu"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu" />
    </LinearLayout>

    <View
        android:id="@+id/lineTop"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <app.pitchmonitor.byz.PitchView
            android:id="@+id/graph"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btnHold"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="@string/hold"
            android:textSize="16dp" />

        <TextView
            android:id="@+id/btnLive"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="64dp"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/back_to_live"
            android:textSize="13dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/transport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnStop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Stop"
                android:src="@drawable/ic_stop" />

            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Record"
                android:src="@drawable/ic_record" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Play"
                android:src="@drawable/ic_play" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/lineBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingTop="7dp"
        android:paddingRight="4dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/btnScale"
            style="@style/Chip"
            android:layout_weight="2.3"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textSize="12dp" />

        <LinearLayout
            android:id="@+id/baseControls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="8.1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBaseVoice"
                style="@style/Chip"
                android:layout_weight="1.45"
                android:contentDescription="Base = voice"
                android:maxLines="2"
                android:text="@string/base_voice"
                android:textSize="11dp" />

            <TextView
                android:id="@+id/btnBaseReset"
                style="@style/Chip"
                android:layout_weight="1.25"
                android:contentDescription="Back to the natural base"
                android:text="@string/reset"
                android:textSize="12dp" />

            <TextView
                android:id="@+id/btnDown1"
                style="@style/Chip.Step"
                android:contentDescription="Down 1 moria"
                android:text="−1" />

            <TextView
                android:id="@+id/btnDown6"
                style="@style/Chip.Step"
                android:contentDescription="Down 6 moria"
                android:text="−6" />

            <TextView
                android:id="@+id/baseDetails"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/base_reset_hint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_weight="1.6"
                android:gravity="center"
                android:textSize="10.5dp" />

            <TextView
                android:id="@+id/btnUp6"
                style="@style/Chip.Step"
                android:contentDescription="Up 6 moria"
                android:text="+6" />

            <TextView
                android:id="@+id/btnUp1"
                style="@style/Chip.Step"
                android:contentDescription="Up 1 moria"
                android:text="+1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- Wide screens (600 dp and up): permanent navigation rail on the right. -->
    <View
        android:id="@+id/railLine"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/mainRail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:visibility="gone" />
</LinearLayout>
